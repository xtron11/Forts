# Скопируйте в server/.env и заполните. Файл .env не коммитится.

# development | production | test
NODE_ENV=development

# Токен бота от @BotFather — нужен для проверки подписи initData.
BOT_TOKEN=123456789:replace-with-your-bot-token

# Совпадает с docker-compose.yml для локальной разработки.
DATABASE_URL=postgres://forts:forts@localhost:5433/forts

# Случайная строка не короче 32 символов, например: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters

# Адреса клиента через запятую, с которых разрешены запросы к API.
CORS_ORIGIN=http://localhost:5173

# Необязательно: адрес и порт сервера.
# HOST=0.0.0.0
# PORT=3000
