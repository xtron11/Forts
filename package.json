{
  "name": "forts",
  "private": true,
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w @forts/server\" \"npm run dev -w @forts/client\"",
    "dev:client": "npm run dev -w @forts/client --",
    "dev:server": "npm run dev -w @forts/server",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate -w @forts/server",
    "test": "npm test --workspaces --if-present",
    "build": "npm run typecheck && npm run build -w @forts/client",
    "preview": "npm run preview -w @forts/client --",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
